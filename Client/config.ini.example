; 复制本文件为 config.ini 并填入真实值；config.ini 已被 gitignore，不会入库
[GateServer]
host=<GATE_SERVER_HOST>
port=8080
[Upload]
; Max bytes per upload, 314572800 = 300MB.
; !! MUST stay <= GateServer's [Upload] MaxBytes, otherwise the client lets a
; file through that the server then rejects after the whole transfer.
MaxBytes=314572800
