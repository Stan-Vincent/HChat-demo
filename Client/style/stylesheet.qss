/* ============================================================================
 * HChat 客户端样式表
 * 组织顺序：
 *   1. 全局基础（字体 / 颜色 / 通用控件）
 *   2. 登录 / 注册 / 重置
 *   3. 主聊天界面（侧边栏 / 搜索 / 列表 / 聊天页）
 *   4. 好友申请 / 好友信息
 *   5. 添加好友 / 认证好友
 *   6. 弹窗（加载 / 查找成功 / 查找失败）
 *   7. 自定义控件（状态标签 / 图标按钮 / 进度条 / 红点）
 * ========================================================================= */

/* ============================================================================
 * 0. 设计 tokens（P1 设计系统 · 2026-10-26）
 *   主色 accent   #4C5FD7   hover #3F4FC4   pressed #3543A8   soft #EEF0FB
 *   中性色        bg-page #F5F6F8  bg-card #FFFFFF  bg-hover #ECEDEF
 *                 text-1 #1A1A1A  text-2 #6B6F76  text-3 #A0A4AB  border #E4E6EB
 *   语义色        danger #E5484D
 *   头像色板      common/avatarutil.cpp（低饱和 8 色 + 深墨字）
 *   注意：本文件经 qrc 嵌入（:/style/stylesheet.qss），改动后必须重新构建（rcc）才生效。
 * ========================================================================= */

/* ============================================================================
 * 1. 全局基础
 * ========================================================================= */

/* 默认字体和文字色：让所有控件有个统一基线 */
QWidget {
    font-family: "Microsoft YaHei", "微软雅黑", sans-serif;
    font-size: 14px;
    color: #1f1f1f;
}

/* QLineEdit 的 placeholder 颜色（默认太浅） */
QLineEdit {
    placeholder-text-color: #b0b0b0;
}

/* 输入框获得焦点时的边框（默认是系统蓝，丑） */
QLineEdit:focus {
    border: 1px solid #4c5fd7;
}

/* Tooltip（默认黄底，太土） */
QToolTip {
    background-color: #2e2e2e;
    color: #ffffff;
    border: none;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
}

/* QMenu（右键菜单） */
QMenu {
    background-color: #ffffff;
    border: 1px solid #e4e6eb;
    border-radius: 6px;
    padding: 4px 0;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
    margin: 0 4px;
}
QMenu::item:selected {
    background-color: #e8f8ec;
    color: #4c5fd7;
}
QMenu::separator {
    height: 1px;
    background: #ececec;
    margin: 4px 8px;
}

/* 消息框（默认样式太朴素） */
QMessageBox {
    background-color: #ffffff;
}
QMessageBox QLabel {
    font-size: 14px;
    color: #1f1f1f;
}
QMessageBox QPushButton {
    min-width: 70px;
    min-height: 28px;
    background: #ecedef;
    border: none;
    border-radius: 14px;
    padding: 0 16px;
    font-size: 14px;
}
QMessageBox QPushButton:hover {
    background: #ecedef;
}
QMessageBox QPushButton:pressed {
    background: #e4e6eb;
}

/* ============================================================================
 * 2. 登录 / 注册 / 重置 对话框
 * ========================================================================= */

/* 三个对话框背景透明：渐变背景已上移到 main_widget 登录态（淡橙渐变），
   与无边框圆角容器融为一体；聊天态 main_widget 自动转白。 */
QDialog#LoginDialog,
QDialog#RegisterDialog,
QDialog#ResetDialog {
    background: transparent;
}

/* 用户名 / 密码标签 */
#user_label, #pass_label {
    color: #1f1f1f;
    font-size: 14px;
}

/* 错误提示：成功=绿，错误=红 */
#err_tip[state='normal'] {
    color: #4c5fd7;
}
#err_tip[state='err'] {
    color: #e5484d;
}

/* 密码可见性图标：六状态（4 个图片状态，press 复用 hover） */
#pass_visible[state='unvisible']        { border-image: url(:/res/unvisible.svg); }
#pass_visible[state='unvisible_hover']  { border-image: url(:/res/unvisible_hover.svg); }
#pass_visible[state='visible']          { border-image: url(:/res/visible.svg); }
#pass_visible[state='visible_hover']    { border-image: url(:/res/visible_hover.svg); }

#confirm_visible[state='unvisible']       { border-image: url(:/res/unvisible.svg); }
#confirm_visible[state='unvisible_hover'] { border-image: url(:/res/unvisible_hover.svg); }
#confirm_visible[state='visible']         { border-image: url(:/res/visible.svg); }
#confirm_visible[state='visible_hover']   { border-image: url(:/res/visible_hover.svg); }

/* 注册成功 / 重置成功 的提示文字 */
#tip_lb, #tip2_lb {
    color: #4c5fd7;
}

/* 忘记密码标签：普通黑，hover 蓝 */
#forget_label[state='normal'],
#forget_label[state='selected'] {
    color: #1f1f1f;
}
#forget_label[state='hover'],
#forget_label[state='selected_hover'] {
    color: #4c5fd7;
}

/* 注册/重置界面的输入框（统一圆角） */
#RegisterDialog QLineEdit,
#ResetDialog QLineEdit,
#LoginDialog QLineEdit {
    border: 1px solid #e4e6eb;
    border-radius: 10px;
    padding: 6px 10px;
    background: #ffffff;
    selection-background-color: #d5daf6;
    selection-color: #2e3570;
}
#RegisterDialog QLineEdit:hover,
#ResetDialog QLineEdit:hover,
#LoginDialog QLineEdit:hover {
    border: 1px solid #c9cdd6;
}
#RegisterDialog QLineEdit:focus,
#ResetDialog QLineEdit:focus,
#LoginDialog QLineEdit:focus {
    border: 1px solid #4c5fd7;
    background: #f0f2fd;
}

/* ============================================================================
 * 3. 主聊天界面
 * ========================================================================= */

/* ---------- 3.1 左侧功能栏 ---------- */
#side_bar {
    background-color: #2e2e2e;
}

/* 侧边栏按钮：聊天 / 联系人 / 设置 各六状态（图片控制）
   ★ 选中态（selected_*）用 hover 的浅灰圆图而不是 press 的橙圆图：
     深色侧边栏上浅灰圆已经能区分选中/未选中，再套一圈主题色太跳。 */
#side_chat_lb[state='normal']           { border-image: url(:/res/chat_icon.svg); }
#side_chat_lb[state='hover']            { border-image: url(:/res/chat_icon_hover.svg); }
#side_chat_lb[state='pressed']          { border-image: url(:/res/chat_icon_press.svg); }
#side_chat_lb[state='selected_normal']  { border-image: url(:/res/chat_icon_hover.svg); }
#side_chat_lb[state='selected_hover']   { border-image: url(:/res/chat_icon_hover.svg); }
#side_chat_lb[state='selected_pressed'] { border-image: url(:/res/chat_icon_hover.svg); }

#side_contact_lb[state='normal']           { border-image: url(:/res/contact_list.svg); }
#side_contact_lb[state='hover']            { border-image: url(:/res/contact_list_hover.svg); }
#side_contact_lb[state='pressed']          { border-image: url(:/res/contact_list_press.svg); }
#side_contact_lb[state='selected_normal']  { border-image: url(:/res/contact_list_hover.svg); }
#side_contact_lb[state='selected_hover']   { border-image: url(:/res/contact_list_hover.svg); }
#side_contact_lb[state='selected_pressed'] { border-image: url(:/res/contact_list_hover.svg); }

#side_settings_lb[state='normal']           { border-image: url(:/res/settings.svg); }
#side_settings_lb[state='hover']            { border-image: url(:/res/settings_hover.svg); }
#side_settings_lb[state='pressed']          { border-image: url(:/res/settings_press.svg); }
#side_settings_lb[state='selected_normal']  { border-image: url(:/res/settings_hover.svg); }
#side_settings_lb[state='selected_hover']   { border-image: url(:/res/settings_hover.svg); }
#side_settings_lb[state='selected_pressed'] { border-image: url(:/res/settings_hover.svg); }

/* ---------- 3.2 搜索栏 ---------- */
#search_wid {
    background-color: #f7f7f7;
    border-bottom: 1px solid #ececec;
}
#search_edit {
    border: 1px solid #e4e6eb;
    border-radius: 6px;
    background: #ffffff;
    padding: 3px 8px;
    selection-background-color: #d5daf6;
    selection-color: #2e3570;
}
#search_edit:hover {
    border: 1px solid #c9cdd6;
}
#search_edit:focus {
    border: 1px solid #4c5fd7;
    background: #f0f2fd;
}

/* 添加群组按钮（原 QSS 中重复定义两次，这里只留一份） */
#add_btn[state='normal'] { border-image: url(:/res/add_friend_normal.svg); }
#add_btn[state='hover']  { border-image: url(:/res/add_friend_hover.svg); }
#add_btn[state='press']  { border-image: url(:/res/add_friend_hover.svg); }

/* ---------- 3.3 会话 / 联系人 / 搜索 列表 ---------- */
#chat_user_list,
#con_user_list,
#search_list {
    background-color: #f7f7f8;
    border: none;
    outline: none;
}
#chat_user_list::item:selected,
#con_user_list::item:selected,
#search_list::item:selected {
    /* 左侧主色竖条(~3px) + 浅橘底：比纯色块更有层次，
       竖条用渐变模拟（QSS 的 ::item 不支持 border-left） */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #4c5fd7, stop:0.012 #4c5fd7,
                                stop:0.012 #e3e7fa, stop:1 #e3e7fa);
    border: none;
    outline: none;
}
#chat_user_list::item:hover,
#con_user_list::item:hover,
#search_list::item:hover {
    background-color: #eef0fb;
    border: none;
    outline: none;
}
#chat_user_list::item:focus,
#con_user_list::item:focus,
#search_list::item:focus {
    border: none;
    outline: none;
}

/* 无效的占位项（隐藏用） */
#invalid_item {
    background-color: #eaeaea;
    border: none;
}

/* 列表项里的名字 / 摘要 / 时间 */
#user_name_lb {
    color: #000000;
    font-size: 16px;
    font-weight: normal;
}
#user_chat_lb {
    color: #999999;
    font-size: 14px;
}
#already_add_lb {
    color: #999999;
    font-size: 12px;
}
#time_wid #time_lb {
    color: #8c8c8c;
    font-size: 12px;
}

/* 聊天气泡条目 hover 浮出的时间（ChatItemBase::m_pTimeLabel）：
   必须用不透明白底 + 细边框——半透明(rgba)背景会被 Qt 合成进父控件
   backing store，隐藏后残留鬼影，把旁边消息文字染灰。位置在 C++ 里
   手工定位（贴气泡右侧/左侧，垂直居中，不占布局）。 */
#chat_item_time {
    color: #8c8c8c;
    font-size: 12px;
    background-color: #ffffff;
    border: 1px solid #e8e8e8;
    border-radius: 4px;
    padding: 1px 6px;
}

/* ---------- 3.4 聊天页 ---------- */
#chat_data_list {
    background: #f5f6f8;
}
#chat_bg {
    background: #f5f6f8;
}
#chat_area {
    border: none;
}
#chat_user_name {
    color: #999999;
    font-size: 14px;
}

/* 输入区 */
#tool_wid {
    background: #ffffff;
    border-bottom: 1px solid #ececec;
}
#chatEdit {
    background: #ffffff;
    border: none;
    font-size: 16px;
    padding: 5px;
}
#send_wid {
    background: #ffffff;
    border: none;
}

/* 发送 / 接收按钮（三状态） */
#receive_btn[state='normal'] { background: #ecedef; color: #4c5fd7; font-size: 16px; border-radius: 20px; }
#receive_btn[state='hover']  { background: #dfe1e6; color: #4c5fd7; font-size: 16px; border-radius: 20px; }
#receive_btn[state='press']  { background: #d0d3d9; color: #4c5fd7; font-size: 16px; border-radius: 20px; }

#send_btn[state='normal'] { background: #ecedef; color: #4c5fd7; font-size: 16px; border-radius: 20px; }
#send_btn[state='hover']  { background: #dfe1e6; color: #4c5fd7; font-size: 16px; border-radius: 20px; }
#send_btn[state='press']  { background: #d0d3d9; color: #4c5fd7; font-size: 16px; border-radius: 20px; }

/* 表情 / 文件按钮（三状态） */
#emo_lb[state='normal'] { border-image: url(:/res/smile.svg); }
#emo_lb[state='hover']  { border-image: url(:/res/smile_hover.svg); }
#emo_lb[state='press']  { border-image: url(:/res/smile_press.svg); }

#file_lb[state='normal'] { border-image: url(:/res/filedir.svg); }
#file_lb[state='hover']  { border-image: url(:/res/filedir_hover.svg); }
#file_lb[state='press']  { border-image: url(:/res/filedir_press.svg); }

/* ---------- 3.5 消息类型图标（表情 / 文件 / 发送） ---------- */
#add_tip  { border-image: url(:/res/addtip.svg); }
#right_tip{ border-image: url(:/res/right_tip.svg); }
#message_tip {
    text-align: center;
    font-size: 12pt;
}

/* ============================================================================
 * 4. 好友申请 / 好友信息
 * ========================================================================= */

/* 分组标题（"新的朋友" / "联系人"） */
#GroupTipItem {
    background-color: #eaeaea;
    border: none;
}
#GroupTipItem QLabel {
    color: #2e2f30;
    font-size: 12px;
    border: none;
}

/* "新的朋友" 项 */
#new_friend_item {
    border-bottom: 1px solid #eaeaea;
}

/* 分隔线 */
#LineItem {
    background-color: #f7f7f7;
    border: none;
}

/* 申请页顶部标题栏 */
#friend_apply_lb {
    font-size: 18px;
    font-weight: normal;
}
#friend_apply_wid {
    background-color: #f1f2f3;
    border-bottom: 1px solid #e4e6eb;
}

/* 申请列表 */
#apply_friend_list {
    background-color: #f1f2f3;
    border-left: 1px solid #e4e6eb;
    border-top: none;
    border-right: none;
    border-bottom: none;
}

/* 申请项 */
ApplyFriendItem {
    background-color: #f1f2f3;
    border-bottom: 2px solid #dbd9d9;
}
ApplyFriendItem #user_chat_lb {
    color: #a2a2a2;
    font-size: 14px;
}
ApplyFriendItem #addBtn[state='normal'] { background-color: #ecedef; color: #4c5fd7; font-size: 16px; border-radius: 20px; }
ApplyFriendItem #addBtn[state='hover']  { background-color: #dfe1e6; color: #4c5fd7; font-size: 16px; border-radius: 20px; }
ApplyFriendItem #addBtn[state='press']  { background-color: #d0d3d9; color: #4c5fd7; font-size: 16px; border-radius: 20px; }

/* 好友信息页 */
#friend_info_page #name_lb {
    color: #161616;
    font-size: 18px;
}
#friend_info_page #nick_tip,
#friend_info_page #nick_lb,
#friend_info_page #bak_lb,
#friend_info_page #bak_tip {
    color: #161616;
    font-size: 14px;
}

/* 发消息 / 视频 / 语音 按钮 */
#msg_chat[state='normal']   { border-image: url(:/res/msg_chat_normal.svg); }
#msg_chat[state='hover']    { border-image: url(:/res/msg_chat_hover.svg); }
#msg_chat[state='press']    { border-image: url(:/res/msg_chat_press.svg); }

#video_chat[state='normal'] { border-image: url(:/res/video_chat_normal.svg); }
#video_chat[state='hover']  { border-image: url(:/res/video_chat_hover.svg); }
#video_chat[state='press']  { border-image: url(:/res/video_chat_press.svg); }

#voice_chat[state='normal'] { border-image: url(:/res/voice_chat_normal.svg); }
#voice_chat[state='hover']  { border-image: url(:/res/voice_chat_hover.svg); }
#voice_chat[state='press']  { border-image: url(:/res/voice_chat_press.svg); }

/* ============================================================================
 * 5. 添加好友 / 认证好友
 * ========================================================================= */

#ApplyFriend {
    border: 2px solid #f1f1f1;
    font-size: 14px;
    background: #f7f7f8;
}
#AuthenFriend {
    border: 2px solid #f1f1f1;
    font-size: 14px;
    background: #f7f7f8;
}

#scrollArea { background: #f7f7f8; border: none; }
#scrollcontent { background: #f7f7f8; }
#scrollcontent #apply_lb {
    font-size: 16px;
    font-weight: normal;
}

#apply_wid QLabel {
    color: #8c8c8c;
    font-size: 14px;
    height: 25px;
}
#apply_wid #name_ed, #apply_wid #back_ed {
    border: 1px solid #f7f7f8;
    font-size: 14px;
}
#apply_wid #lb_ed {
    border: none;
    font-size: 14px;
}
#apply_wid #more_lb {
    border-image: url(:/res/arowdown.svg);
}

/* 标签（六状态） */
#apply_wid #tipslb[state='normal']           { padding: 2px; background: #e1e1e1; color: #1e1e1e; border-radius: 10px; }
#apply_wid #tipslb[state='hover']            { padding: 2px; background: #e1e1e1; color: #1e1e1e; border-radius: 10px; }
#apply_wid #tipslb[state='pressed']          { padding: 2px; background: #e1e1e1; color: #4c5fd7; border-radius: 10px; }
#apply_wid #tipslb[state='selected_normal']  { padding: 2px; background: #e1e1e1; color: #4c5fd7; border-radius: 10px; }
#apply_wid #tipslb[state='selected_hover']   { padding: 2px; background: #e1e1e1; color: #4c5fd7; border-radius: 10px; }
#apply_wid #tipslb[state='selected_pressed'] { padding: 2px; background: #e1e1e1; color: #1e1e1e; border-radius: 10px; }

/* 输入框下方的提示 */
#input_tip_wid {
    background: #f0f2fd;
}

/* 已加入的标签（带关闭按钮） */
#apply_wid #FriendLabel {
    background: #e3e7fa;
    color: #4c5fd7;
    border-radius: 10px;
}
#apply_wid #tip_lb {
    padding-left: 2px;
    color: #999999;
    font-size: 14px;
}

#gridWidget {
    background: #fdfdfd;
}

/* 关闭按钮（六状态，都用同一个图） */
#close_lb[state='normal']         { border-image: url(:/res/tipclose.svg); }
#close_lb[state='hover']          { border-image: url(:/res/tipclose.svg); }
#close_lb[state='pressed']        { border-image: url(:/res/tipclose.svg); }
#close_lb[state='select_normal']  { border-image: url(:/res/tipclose.svg); }
#close_lb[state='select_hover']   { border-image: url(:/res/tipclose.svg); }
#close_lb[state='select_pressed'] { border-image: url(:/res/tipclose.svg); }

/* 确定 / 取消 按钮 */
#apply_sure_wid #sure_btn[state='normal'] { background: #ecedef; color: #4c5fd7; font-size: 16px; border-radius: 20px; }
#apply_sure_wid #sure_btn[state='hover']  { background: #dfe1e6; color: #4c5fd7; font-size: 16px; border-radius: 20px; }
#apply_sure_wid #sure_btn[state='press']  { background: #d0d3d9; color: #4c5fd7; font-size: 16px; border-radius: 20px; }

#apply_sure_wid #cancel_btn[state='normal'] { background: #ecedef; color: #2e2f30; font-size: 16px; border-radius: 20px; }
#apply_sure_wid #cancel_btn[state='hover']  { background: #dfe1e6; color: #2e2f30; font-size: 16px; border-radius: 20px; }
#apply_sure_wid #cancel_btn[state='press']  { background: #d0d3d9; color: #2e2f30; font-size: 16px; border-radius: 20px; }

/* ============================================================================
 * 6. 弹窗
 * ========================================================================= */

/* 加载中弹窗 */
LoadingDlg {
    background: #f5f6f8;
}
LoadingDlg #status_lb {
    color: #999999;
    font-size: 18px;
}

/* 查找成功弹窗 */
#FindSuccessDlg {
    background-color: #ffffff;
}
#name_lb {
    font-size: 14px;
}
#add_friend_btn[state='normal'] { background: #4c5fd7; color: #ffffff; font-size: 14px; border-radius: 20px; }
#add_friend_btn[state='hover']  { background: #3f4fc4; color: #ffffff; font-size: 14px; border-radius: 20px; }
#add_friend_btn[state='press']  { background: #3543a8; color: #ffffff; font-size: 14px; border-radius: 20px; }

/* 查找失败弹窗 */
#FindFailDlg {
    background-color: #ffffff;
}
#fail_tip, #fail_tip2 {
    font-size: 14px;
}
#fail_sure_btn[state='normal'] { background: #4c5fd7; color: #ffffff; font-size: 14px; border-radius: 20px; }
#fail_sure_btn[state='hover']  { background: #3f4fc4; color: #ffffff; font-size: 14px; border-radius: 20px; }
#fail_sure_btn[state='press']  { background: #3543a8; color: #ffffff; font-size: 14px; border-radius: 20px; }

/* ============================================================================
 * 7. 自定义控件
 * ========================================================================= */

/* 红点（未读提示） */
#red_point {
    border-image: url(:/res/red_point.svg);
}

/* 滚动条（垂直 + 水平统一美化） */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c9cdd6;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #a0a4ab;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: transparent;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #c9cdd6;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #a0a4ab;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: transparent;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* 进度条（PictureBubble 里也会单独设置，这里给个全局默认） */
QProgressBar {
    border: 1px solid #ccc;
    border-radius: 3px;
    background-color: #ecedef;
    text-align: center;
    font-size: 10px;
}
QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                      stop:0 #4c5fd7, stop:1 #3543a8);
    border-radius: 2px;
}


/* ============================================================
   登录 / 注册 / 重置密码 三个界面的表单控件
   （原版教程没给这些做样式，所以登录页看起来很朴素，这里补上）
   ============================================================ */

/* 输入框：白底 + 圆角 + 细边框，聚焦时边框变主色 */
#email_edit, #pass_edit, #user_edit, #pwd_edit,
#verify_edit, #confirm_edit, #varify_edit {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 10px;
    padding: 4px 8px;
    color: #1f1f1f;
    selection-background-color: #6b7ce8;
    selection-color: #ffffff;
}
#email_edit:hover, #pass_edit:hover, #user_edit:hover, #pwd_edit:hover,
#verify_edit:hover, #confirm_edit:hover, #varify_edit:hover {
    border: 1px solid #bebebe;
}
#email_edit:focus, #pass_edit:focus, #user_edit:focus, #pwd_edit:focus,
#verify_edit:focus, #confirm_edit:focus, #varify_edit:focus {
    border: 1px solid #6b7ce8;
}
#email_edit:disabled, #pass_edit:disabled, #user_edit:disabled, #pwd_edit:disabled {
    background-color: #f7f7f7;
    color: #b0b0b0;
}

/* 文字标签 */
#email_label, #user_label, #pass_label, #verify_label, #confirm_label {
    color: #333333;
    font-size: 12pt;
}

/* 主按钮：绿色实心（统一 10px 圆角；登录主按钮单独覆盖为 22px 胶囊） */
#login_btn, #submit_btn, #sure_btn, #up_btn {
    background-color: #4c5fd7;
    border: none;
    border-radius: 10px;
    color: #ffffff;
    font-size: 12pt;
    font-weight: bold;
}
#login_btn {
    border-radius: 22px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                               stop:0 #5a6be0, stop:1 #4c5fd7);
}
#submit_btn:hover, #sure_btn:hover, #up_btn:hover {
    background-color: #3f4fc4;
}
/* 登录主按钮 hover：渐变提亮（与 #login_btn 基准渐变同方向） */
#login_btn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                               stop:0 #6b7ce8, stop:1 #5a6be0);
}
#submit_btn:pressed, #sure_btn:pressed, #up_btn:pressed {
    background-color: #3543a8;
}
/* 登录主按钮按下：渐变压暗 */
#login_btn:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                               stop:0 #4c5fd7, stop:1 #3543a8);
}
#login_btn:disabled {
    background-color: #cccccc;
    color: #888888;
}

/* 次要按钮：描边（统一 10px 圆角，与输入框风格一致） */
#return_btn, #cancel_btn, #varify_btn, #find_btn, #logout_btn {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 10px;
    color: #555555;
    font-size: 12pt;
}
#return_btn:hover, #cancel_btn:hover, #varify_btn:hover, #find_btn:hover,
#logout_btn:hover {
    border: 1px solid #4c5fd7;
    color: #4c5fd7;
}
#return_btn:pressed, #cancel_btn:pressed, #varify_btn:pressed, #logout_btn:pressed {
    background-color: #ecedef;
}

/* 「记住密码 / 自动登录」这类复选框 */
#remember_pwd_chk, #auto_login_chk {
    color: #666666;
    font-size: 10pt;
    spacing: 6px;
}
#remember_pwd_chk::indicator, #auto_login_chk::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #2e2e2e;
    border-radius: 2px;
    background-color: #ffffff;
}
#remember_pwd_chk::indicator:checked, #auto_login_chk::indicator:checked {
    /*选中填绿，但边框保留深色 —— 绿底+绿边会糊成一团、看不出方框形状 */
    background-color: #6b7ce8;
    border: 1px solid #2e2e2e;
}

/* 个人信息页（UserInfoPage）输入框 / 下拉框 */
#nick_ed, #name_ed, #desc_ed {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 10px;
    padding: 4px 8px;
    color: #1f1f1f;
}
#nick_ed:hover, #name_ed:hover, #desc_ed:hover {
    border: 1px solid #bebebe;
}
#nick_ed:focus, #name_ed:focus, #desc_ed:focus {
    border: 1px solid #6b7ce8;
    background-color: #f0f2fd;
}

#sex_cbx {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 10px;
    padding: 4px 8px;
    color: #1f1f1f;
}
#sex_cbx:hover {
    border: 1px solid #bebebe;
}
#sex_cbx:focus {
    border: 1px solid #6b7ce8;
    background-color: #f0f2fd;
}
#sex_cbx::drop-down {
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    width: 24px;
    border-left: 1px solid #d0d0d0;
}
#sex_cbx::down-arrow {
    width: 12px;
    height: 12px;
}

/* ============================================================================
 * 8. 无边框窗口：标题栏与窗口按钮
 * ========================================================================= */

/* ============================================================================
 * 8. 无边框窗口：标题栏与窗口按钮
 *
 * ★ P1 §2 批准的"轻量标题栏"：白底 + 1px 底框，主色仅作强调，去大色块。
 *   承载窗口按钮的 #title_bar 改为白底（bg-card），底部 1px border 分隔；
 *   聊天页会话标题区 #title_lb 维持深色文字，落在白底上更克制现代。
 * ========================================================================= */

/* 标题栏：白底轻量条（P1 §2：去大色块，主色仅作强调） */
#title_bar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E4E6EB;
}

/* 会话标题区：白底，标题文字深色（P1 §2：14px / 500） */
#title_lb {
    color: #1A1A1A;
    font-size: 14px;
    font-weight: 500;
}

/* 窗口按钮（最小化 / 最大化 / 关闭 / 小窗右上角按钮）通用样式。
   白底标题栏：字符改深灰 #1A1A1A；小窗浮动按钮另有更具体的深色覆盖。 */
QPushButton#win_min,
QPushButton#win_max,
QPushButton#win_close,
QPushButton#win_min_small,
QPushButton#win_close_small {
    background-color: transparent;
    border: none;
    color: #1A1A1A;
    font-size: 13px;
    border-radius: 6px;
    padding: 0;
    text-align: center;
}
/* 小窗（登录页）是白底，浮动按钮必须是深色才看得见 —— 用更具体的选择器盖回去 */
QPushButton#win_min_small,
QPushButton#win_close_small {
    color: #444441;
}
QPushButton#win_min:hover,
QPushButton#win_max:hover {
    background-color: #ECEDEF;
}
QPushButton#win_min:pressed,
QPushButton#win_max:pressed {
    background-color: #E4E6EB;
}
/* 小窗 hover 仍用灰底（白底页面上） */
QPushButton#win_min_small:hover {
    background-color: #ecedef;
}
QPushButton#win_min_small:pressed {
    background-color: #e0e0e0;
}
/* 关闭按钮 hover 变红，提示"这是关闭"（与 QQ 一致） */
QPushButton#win_close:hover {
    background-color: #e5484d;
    color: #ffffff;
}
QPushButton#win_close:pressed {
    background-color: #c20d1d;
    color: #ffffff;
}
/* 小窗关闭按钮：白底上 hover 变红 */
QPushButton#win_close_small:hover {
    background-color: #e5484d;
    color: #ffffff;
}
QPushButton#win_close_small:pressed {
    background-color: #c20d1d;
    color: #ffffff;
}

/* ============================================================================
 * 9. Design Tokens & 按钮体系
 * ----------------------------------------------------------------------------
 * 调色板（全局统一引用，避免散落硬编码）：
 *   primary          #4c5fd7   主色（登录焦点边 / 主按钮）
 *   primary-hover    #6b7ce8
 *   primary-press    #3543a8
 *   primary-disabled #d5daf6
 *   link             #4c5fd7   文字按钮
 *   link-hover       #6b7ce8
 *   link-press       #3543a8
 *   ghost-bg         #ffffff
 *   ghost-border     #e3e3e3
 *   ghost-hover-bg   #f0f2fd
 *   text             #1f1f1f
 * 用法：在代码里对按钮 setProperty("role","primary|link|ghost") 后调用 reload_qss(btn)
 * ========================================================================= */

/* primary：实心主色按钮（登录 / 注册 / 确认 / 提交 / 发送等主操作） */
QPushButton[role="primary"] {
    background-color: #4c5fd7;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 0 16px;
    font-size: 14px;
    font-weight: 500;
}
QPushButton[role="primary"]:hover { background-color: #6b7ce8; }
QPushButton[role="primary"]:pressed { background-color: #3543a8; }
QPushButton[role="primary"]:disabled { background-color: #d5daf6; color: #ffffff; }

/* link：文字型按钮 / 嵌入背景链接（去注册 / 返回 / 退出 / 获取验证码等次级操作） */
QPushButton[role="link"],
QPushButton[role="link"]:hover,
QPushButton[role="link"]:pressed,
QPushButton[role="link"]:disabled {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 0;
    min-height: 0;
}
QPushButton[role="link"] {
    color: #4c5fd7;
    font-size: 11pt;
}
QPushButton[role="link"]:hover { color: #6b7ce8; text-decoration: underline; }
QPushButton[role="link"]:pressed { color: #3543a8; }
QPushButton[role="link"]:disabled { color: #bbbbbb; }

/* 兜底：确保登录页注册按钮保持 QQ 式嵌入背景文字（role 选择器在某些 Qt 版本下不够稳） */
QPushButton#reg_btn,
QPushButton#reg_btn:hover,
QPushButton#reg_btn:pressed,
QPushButton#reg_btn:disabled {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 0;
    min-height: 0;
}
QPushButton#reg_btn {
    color: #4c5fd7;
    font-size: 11pt;
}
QPushButton#reg_btn:hover { color: #6b7ce8; text-decoration: underline; }
QPushButton#reg_btn:pressed { color: #3543a8; }
QPushButton#reg_btn:disabled { color: #bbbbbb; }

/* ghost：描边浅底按钮（取消 / 上传等次次要操作） */
QPushButton[role="ghost"] {
    background-color: #ffffff;
    color: #1f1f1f;
    border: 1px solid #e3e3e3;
    border-radius: 6px;
    padding: 0 16px;
    font-size: 14px;
}
QPushButton[role="ghost"]:hover { border-color: #4c5fd7; color: #4c5fd7; }
QPushButton[role="ghost"]:pressed { background-color: #f0f2fd; }

/* 注册成功页「立即返回」：objectName=return_btn 的遗留描边规则(#return_btn,行710)
   的 ID 优先级会压过 [role=primary]，这里用更高优先级(ID+属性)显式改成主按钮样式，
   与「确认」按钮一致；仅在 role=primary 时生效，不影响 reset 对话框的 return_btn(role=link)。 */
QPushButton#return_btn[role="primary"] {
    background-color: #4c5fd7;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 0 24px;
    font-size: 12pt;
    font-weight: bold;
}
QPushButton#return_btn[role="primary"]:hover { background-color: #3f4fc4; }
QPushButton#return_btn[role="primary"]:pressed { background-color: #3543a8; }

/* ============================================================
   上传进度条（ChatPage 输入框上方，objectName=upload_bar）
   细条形态：6px 高、圆角、主色填充。不确定进度时 Qt 会显示
   滚动动画（setRange(0,0)），这里把 chunk 颜色也交给 qss 管。
   ============================================================ */
QProgressBar#upload_bar {
    background: #ecedef;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    min-height: 6px;
}
QProgressBar#upload_bar::chunk {
    background: #4c5fd7;
    border-radius: 3px;
}
QProgressBar#upload_bar[indeterminate="true"]::chunk {
    background: #6b7ce8;
}
